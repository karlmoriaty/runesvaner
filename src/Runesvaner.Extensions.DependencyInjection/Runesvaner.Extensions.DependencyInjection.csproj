<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Runesvaner\Runesvaner.csproj" />
    <ProjectReference Include="..\Runesvaner.Storage.Jsonl\Runesvaner.Storage.Jsonl.csproj" />
    <ProjectReference Include="..\Runesvaner.Storage.Sqlite\Runesvaner.Storage.Sqlite.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Runesvaner.Extensions.DependencyInjection</PackageId>
    <Description>Dependency injection integration and default storage selection for Runesvaner.</Description>
    <Authors>karlmoriaty</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/karlmoriaty/runesvaner</RepositoryUrl>
    <PackageTags>dotnet;ai;diagnostics;observability;aot</PackageTags>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>