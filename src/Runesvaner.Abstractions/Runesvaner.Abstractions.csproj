<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>true</IsPackable>
    <PackageId>Runesvaner.Abstractions</PackageId>
    <Description>Core abstractions for Runesvaner.</Description>
    <Authors>karlmoriaty</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/karlmoriaty/runesvaner</RepositoryUrl>
    <PackageTags>dotnet;ai;diagnostics;observability;aot</PackageTags>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
