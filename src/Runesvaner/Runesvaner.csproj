<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Runesvaner.Abstractions\Runesvaner.Abstractions.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Runesvaner</PackageId>
    <Description>Core recorder, options, and storage contracts for Runesvaner.</Description>
    <Authors>karlmoriaty</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/karlmoriaty/runesvaner</RepositoryUrl>
    <PackageTags>dotnet;ai;diagnostics;observability;aot</PackageTags>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\pricing\builtin-prices.json" LogicalName="Runesvaner.Pricing.builtin-prices.json" />
  </ItemGroup>
</Project>